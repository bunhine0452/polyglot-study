# lessongen 이 읽는 환경변수. 이 파일을 `.env` 로 복사해 값을 채우십시오.
#
# 우선순위는 **실제 환경변수 > .env** 입니다 — 셸에서 export 한 값이 항상 이깁니다.
# `.env` 는 커밋되지 않습니다(.gitignore). 키를 저장소·로그·명령행 인자 어디에도
# 남기지 마십시오.

# 필수. OpenRouter API 키. https://openrouter.ai/keys 에서 발급합니다.
OPENROUTER_API_KEY=

# 필수. 기본 모델. `vendor/model-name` 형식입니다.
# 기본값을 두지 않는 것은 의도입니다 — 모델마다 구조화 출력 지원과 가격이 다르므로
# 조용히 고른 모델은 조용한 실패이거나 조용한 청구서입니다.
OPENROUTER_MODEL=

# 선택. 단계별 모델 오버라이드. 없으면 OPENROUTER_MODEL 로 떨어집니다.
#
# 나누는 기준은 **자동 검증 게이트의 유무**입니다. lesson/repair 산출물은 packtool 이
# 실제로 실행해서 검증하므로 값싼 모델이 틀려도 게이트가 잡습니다. outline 은 사람이
# 리뷰합니다. 반면 prose(개념 설명 산문)에는 어떤 자동 게이트도 없어서 사실이 틀린
# 설명이 그대로 학습자에게 갑니다 — 여기에 더 좋은 모델을 꽂으십시오.
#OPENROUTER_MODEL_OUTLINE=
#OPENROUTER_MODEL_LESSON=
#OPENROUTER_MODEL_PROSE=
#OPENROUTER_MODEL_REPAIR=
