<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleExecutable</key>
	<string>Polyglot</string>
	<key>CFBundleIdentifier</key>
	<string>com.polyglotstudy.Polyglot</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Polyglot</string>
	<key>CFBundleDisplayName</key>
	<string>Polyglot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- ── Sparkle 자동 업데이트 ────────────────────────────────────────────
	     {#sparkle-updates} {#sparkle-eddsa-keys} {#sparkle-appcast}

	     SUPublicEDKey 는 `generate_keys` 가 만든 **공개키**다. 짝이 되는 개인키는 로그인
	     키체인(서비스 "https://sparkle-project.org", 계정 "ed25519")에만 있고 저장소에는
	     없다. 릴리스 서명은 `Scripts/release.sh` 가 키체인에서 꺼내 쓴다.

	     SUFeedURL 은 GitHub Pages 를 가리킨다. 이 저장소에는 아직 git 원격도 Pages 도
	     없어서 이 주소로 실제 왕복을 해본 적이 없다 — 원격이 생기면 실제 Pages 주소와
	     같은지 확인해야 하고, Scripts/release.sh 가 appcast 를 굽는 --feed-base 와
	     이 값이 어긋나면 릴리스를 거부한다.

	     SUVerifyUpdateBeforeExtraction: 압축을 풀기 **전에** EdDSA 서명을 검증한다.
	     서명이 틀린 아카이브의 바이트가 애초에 압축 해제기를 타지 않는다.
	-->
	<key>SUFeedURL</key>
	<string>https://polyglotstudy.github.io/polyglot/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>HRRXJyBOBY0aer/wNjrtCQppaKr/qYJrg/BSQhI/6b4=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- 첫 실행에서 "자동으로 확인할까요?" 대화상자를 띄우지 않고 켠 상태로 시작한다.
	     끄는 것은 Sparkle 이 사용자 기본값에 기록한다. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>

	<!-- 폰트 번들링({#plex-font-bundling})의 착지점. 이 키는 앱 번들 Contents/Resources
	     기준 상대 경로에만 먹는다 — SPM 의 Bundle.module 경로에는 효과가 없다. -->
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
</dict>
</plist>
